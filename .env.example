# URL base da API do backend (NestJS)
VITE_API_URL=http://localhost:3000

# URL base do servidor de WebSocket (Socket.io); por omissão usa VITE_API_URL
VITE_SOCKET_URL=http://localhost:3000

# Google OAuth 2.0 client ID (Google Cloud Console -> Credentials -> OAuth client)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
